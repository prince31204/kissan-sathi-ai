WEATHER_API_KEY=""

# MongoDB Setup
MONGODB_USERNAME=""
MONGODB_PASSWORD=""
MONGODB_URI="mongodb+srv://<username>:<password>@cluster.mongodb.net"

# Gemini API Key
GOOGLE_GEMINI_API_KEY="your-gemini-api-key"

# Email Setup (Nodemailer Gmail App Password)
SMTP_EMAIL="your-email@gmail.com"
